# Export these variables in your shell; .env is not loaded automatically.
CV_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=replace-with-a-model-supporting-structured-outputs
# Optional IANA timezone; otherwise the system local timezone is used.
CV_TIMEZONE=Europe/Bucharest

# Local backend: model directory name relative to llm/.
# CLI flags override setup.json, which overrides these environment defaults.
LOCAL_MODEL=my-instruct-model
